<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/void_black"
    android:padding="20dp">

    <!-- Top status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="J.A.R.V.I.S."
            android:textColor="@color/core_idle_cyan"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textColor="@color/text_dim"
            android:fontFamily="monospace"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Reactor core, fills the middle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.jarvis.assistant.ui.ReactorView
            android:id="@+id/reactorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

    <!-- Terminal log -->
    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/panel_dark"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/core_idle_cyan"
            android:text="&gt; system online. tap the core to speak." />
    </ScrollView>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ALWAYS LISTEN"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/text_dim" />

        <Switch
            android:id="@+id/wakeWordToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:fontFamily="monospace"
            android:textColor="@color/core_idle_cyan"
            android:backgroundTint="@color/panel_dark"
            android:layout_marginStart="12dp" />
    </LinearLayout>

</LinearLayout>
